# ==============================================================================
# AI Shopping Assistant - Environment Configuration Template
# Copy this file to .env or .env.openai to configure the service.
# ==============================================================================

# OpenAI Configuration
# Provide your OpenAI API key to enable live LLM synthesis.
# If omitted or invalid, the assistant automatically uses the deterministic fallback engine.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.2

# Shopping Assistant Service Port
PORT=8080

# Pinecone Vector DB Configuration
# Provide your Pinecone API key to connect to your Serverless Pinecone Index.
# If omitted, the service runs in local fallback mode.
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=online-boutique-products
PINECONE_ENVIRONMENT=us-east-1
PINECONE_NAMESPACE=products

# RAG Strategy: hybrid | dense | sparse
RAG_MODE=hybrid

# Catalog Source (relative path to products.json or external API)
CATALOG_PATH=app/data/products.json

# LangChain & LangSmith Observability
# Set LANGCHAIN_TRACING_V2=true and provide your LangSmith API key to trace all calls
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key-here
LANGCHAIN_PROJECT=online-boutique-shopping-assistant
